<?xml version="1.0"?>
<robot name="tactile_test">
  <link name="world"/>
  <link name="base">
    <inertial><mass value="1"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/></inertial>
  </link>
  <joint name="mount" type="fixed"><parent link="world"/><child link="base"/></joint>
  <link name="pad">
    <inertial><origin xyz="0 0 0"/><mass value="1"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <collision><geometry><box size="0.08 0.04 0.02"/></geometry></collision>
    <visual><geometry><box size="0.08 0.04 0.02"/></geometry></visual>
  </link>
  <joint name="slide" type="prismatic">
    <parent link="base"/><child link="pad"/><origin xyz="0 0 0.03"/>
    <axis xyz="0 0 1"/><limit lower="-1" upper="1" effort="100" velocity="1"/>
  </joint>
</robot>
